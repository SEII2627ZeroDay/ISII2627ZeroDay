@startuml
class Game {
    + Id : int <<get>> <<set>>
    + Name : string <<get>> <<set>> = ""
    + Place : string <<get>> <<set>> = "More than 5 chars"
    + Description : string? <<get>> <<set>> = ""
    + ResponsibleForId : string <<get>> <<set>> = ""
    + SportId : int <<get>> <<set>>
}
class "IList`1"<T> {
}
Game --> "Date" DateTime
Game o-> "ResponsibleFor" ApplicationUser
Game o-> "Sport" Sport
Game o-> "GameInvitations<GameInvitation>" "IList`1"
Game --> "RefereeGroup" RefereeGroup
@enduml
